# ==========================================
# AURA SKINCARE — AI VOICE CX AGENT (ARIA)
# Environment Variables Configuration
# ==========================================

# 1. Groq Cloud API (Optional - Recommended for ultra-fast LLaMA 3.3 70B inference)
# Free key from: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini API (Optional - For Gemini 2.5 Flash / 1.5 Flash)
# Free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# 3. OpenAI API (Optional - For GPT-4o-mini)
# From: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# NOTE: The application features a built-in deterministic conversational engine.
# It works immediately out of the box even without any API key set!
# Adding any of the keys above enables live cloud LLM reasoning.
