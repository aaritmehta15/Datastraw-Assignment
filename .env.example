# ==========================================
# AURA SKINCARE — AI VOICE CX AGENT (ARIA)
# Environment Variables Configuration
# ==========================================

# 1. Groq Cloud API (Recommended for sub-second LLaMA 3.3 70B inference)
# Obtain free API key from: https://console.groq.com/keys
GROQ_API_KEY=

# 2. Google Gemini API (Alternative inference provider)
# Obtain API key from: https://aistudio.google.com/
GEMINI_API_KEY=

# NOTE: The application features a built-in deterministic conversational engine.
# It functions out of the box even without external API credentials.
# Supplying GROQ_API_KEY activates cloud neural inference.
